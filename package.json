{
  "name": "minimalist-home",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --level warning",
    "db:types": "supabase gen types typescript --schema public --local > src/lib/supabase/database.types.ts",
    "test:onboarding": "node scripts/test-household-onboarding.mjs"
  },
  "dependencies": {
    "@blobatar/svelte": "^2.7.0",
    "@fullcalendar/icalendar": "^7.1.2",
    "@lucide/svelte": "^1.57.0",
    "@supabase/supabase-js": "^2.118.0",
    "bits-ui": "^2.19.5",
    "blobatar": "^2.7.0",
    "fullcalendar": "^7.1.2",
    "ical.js": "^2.2.1",
    "mode-watcher": "^1.1.0",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.0",
    "cn": "^0.4.0",
    "shadcn-svelte": "^1.7.0",
    "supabase": "^2.121.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.4"
  }
}
