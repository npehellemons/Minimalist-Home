# Same-origin or CORS-enabled endpoint that accepts an iCloud calendar URL
# in its `url` query parameter. Local development uses the built-in Vite proxy.
VITE_CALENDAR_PROXY_URL=/api/apple-calendar

# Supplied automatically by the Vercel Supabase integration in deployed builds.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by the Supabase CLI for remote schema commands. Never expose this.
POSTGRES_URL_NON_POOLING=
